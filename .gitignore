# ─── SEGREDOS E VARIÁVEIS DE AMBIENTE ────────────────────────
.env
.env.*
!.env.example
!.env.local.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ─── UPLOADS E ARQUIVOS DE USUÁRIO (NUNCA COMMITE) ───────────
uploads/
backend/uploads/*
