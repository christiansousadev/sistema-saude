DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_saude
SECRET_KEY=troque-por-uma-chave-segura-de-pelo-menos-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads

# origens aceitas pelo CORS — em produção, substitua pelo domínio real
# use json array para múltiplas origens: ["https://app.com","https://admin.app.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# "development" | "production" — em production, /docs e /redoc são desabilitados
APP_ENV=development
