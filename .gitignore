**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ─── TESTES & COBERTURA ──────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── NODE / FRONTEND ──────────────────────────────────────────
node_modules/
**/node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ─── LOGS, BANCO LOCAL & SISTEMA OPERACIONAL ─────────────────
