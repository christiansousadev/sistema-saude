# ── postgresql ────────────────────────────────────────────────────────────────
POSTGRES_USER=saude_user
POSTGRES_PASSWORD=troque_pela_senha_real
POSTGRES_DB=sistema_saude

# ── backend fastapi ───────────────────────────────────────────────────────────
# gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-hex-de-64-chars-gerada-com-secrets

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# origens aceitas no cors — liste todos os domínios do frontend
ALLOWED_ORIGINS=["http://localhost:3000"]

# development | production  (production desabilita /docs e /redoc)
APP_ENV=development

# ── frontend next.js ──────────────────────────────────────────────────────────
# atenção: NEXT_PUBLIC_* são embutidas em tempo de build docker
# rebuilde o container frontend ao alterar estes valores
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/uploads
